{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.2/.schema/devbox.schema.json",
  "packages": {
    "rustup":                      "1.29.0",
    "pnpm":                        "latest",
    "nodejs":                      "22",
    "python312Packages.fonttools": "latest",
    "python312Packages.pyyaml":    "latest",
    "jq":                          "1.7.1",
    "wget":                        "1.21.4",
    "zip":                         "3.0",
    "gnumake":                     "4.4.1",
    "gnused":                      "4.9",
    "coreutils":                   "latest",
    "findutils":                   "latest",
    "libwebp": {
      "version": "1.6.0",
      "outputs": ["out"]
    },
    "openssl": {
      "version": "latest",
      "outputs": ["out", "dev"]
    },
    "fontconfig": {
      "version": "latest",
      "outputs": ["out", "dev"]
    },
    "glslang": {
      "version": "latest",
      "outputs": ["bin", "out", "dev"]
    },
    "spirv-tools": {
      "version": "latest",
      "outputs": ["out", "lib", "dev"]
    },
    "vulkan-loader": {
      "version": "latest",
      "outputs": ["out", "dev"]
    },
    "vulkan-headers":              "latest",
    "libglvnd":                    "1.7.0",
    "libjpeg8": {
      "version": "3.1.4.1",
      "outputs": ["out", "dev"]
    },
    "curl": {
      "version": "8.17.0",
      "outputs": ["out", "dev"]
    },
    "icu": {
      "version": "latest",
      "outputs": ["out", "dev"]
    },
    "icu74":                       "74.2",
    "libpng": {
      "version": "1.6.43",
      "outputs": ["out", "dev"]
    },
    "libuv": {
      "version": "1.52.1",
      "outputs": ["out", "dev"]
    },
    "mesa":                        "26.2.0",
    "xorg.libX11":                 "1.8.12",
    "xorg.libXext":                "1.3.6",
    "cmake":                       "latest",
    "pkg-config":                  "latest",
    "boost":                       "latest",
    "expat":                       "latest",
    "bzip2":                       "latest",
    "zlib": {
      "version": "1.3.2",
      "outputs": ["out", "dev"]
    },
    "sqlite": {
      "version": "3.53.3",
      "outputs": ["out", "dev"]
    },
    "go":                  "1.25",
    "git":                 "latest",
    "gcc":                 "latest",
    "yq-go":               "latest",
    "yq":                  "latest",
    "libyaml":             "latest",
    "python3":             "latest",
    "python3Packages.pip": ""
  },
  "shell": {
    "init_hook": [
      "export GOPATH=\"${GOPATH:-$HOME/go}\"",
      "export CARGO_HOME=\"${CARGO_HOME:-$HOME/.cargo}\"",
      "export HUAVD_MAP_BUILD_HOME=\"${HUAVD_MAP_BUILD_HOME:-/tmp/huavd-map-build}\"",
      "export HUAVD_TOOLS_DIR=\"${HUAVD_TOOLS_DIR:-$PWD/tools}\"",
      "export PATH=\"$HUAVD_TOOLS_DIR/bin:$HUAVD_TOOLS_DIR/maplibre-native/bin:$HOME/.local/bin:$GOPATH/bin:$CARGO_HOME/bin:$PATH\"",
      ". $VENV_DIR/bin/activate",
      "export LD_LIBRARY_PATH=\"$PWD/.devbox/nix/profile/default/lib:$(dirname $(gcc -print-file-name=libstdc++.so.6))${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\""
    ],
    "scripts": {
      "setup":  "bash scripts/setup-tools.sh",
      "doctor": "make doctor",
      "build":  "make build",
      "pack":   "make pack"
    }
  }
}
